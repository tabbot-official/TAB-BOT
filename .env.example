# Tab environment variables (Tab is based on Jarvis by nicholas-pp8) - copy to .env and fill in what you use.
# NEVER commit your real .env. Everything below is optional unless noted.

# Core
PREFIX=.
OWNER_NUMBER=91XXXXXXXXXX
BOT_TZ=Asia/Kolkata
# Original Jarvis behavior: anonymous install ping to the maintainer is ON by default. Set off to disable.
TELEMETRY=on
# Original Jarvis behavior: signed maintainer suspend/limit directives are ON by default. Set off to disable.
MAINTAINER_DIRECTIVES=on
# Tab: no auto-update from the Jarvis GitHub repo. Set owner/repo only for a repo YOU control.
UPDATE_REPO=

# Session safety
JARVIS_AUTH_BACKUP_KEY=change-me-long-random-string
JARVIS_PRESENCE=on

# AI providers (free tiers). ONE shared line-up for .agent, .ai and .ask:
#   Groq -> Gemini -> OpenRouter (free models) -> Pollinations (no key, 1 reply / 30 s) last.
# Empty or placeholder keys are skipped; a 429, 5xx or timeout falls through to the next one. No restart logic needed:
# add a key and restart the bot once.
# Groq: free key, no card - https://console.groq.com/keys
GROQ_API_KEY=
# Gemini: free key, no card - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter: free key, no card - https://openrouter.ai/keys (only ":free" models are used, they cost nothing)
OPENROUTER_API_KEY=
# Optional: change the order of the keyed providers, e.g. AI_ORDER=gemini,groq,openrouter (Pollinations stays last)
AI_ORDER=
GEMINI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
AGNES_API_KEY=
HF_TOKEN=

# .agent for everyone: requests per user per hour (owner unlimited), and per-tool hourly limits per user.
AGENT_USER_PER_HOUR=3
AGENT_TOOL_LIMITS=search=10,read=10,image=4,song=5,video=3,spotify=5
# Whole-task time caps in seconds (everyone / owner). Each step also has its own limit; ".agent stop" cancels.
AGENT_TASK_CAP_S=300
AGENT_OWNER_TASK_CAP_S=900

# Hosting panel (owner-only .panel command and the .agent restart/status/logs steps). Any Pterodactyl panel, e.g. KataBump.
# PANEL_URL = the panel website, PANEL_SERVER_ID = the short id in the panel's server URL,
# PANEL_API_KEY = a Client API key (panel > Account > API Credentials). The key is never shown in chat or logs.
# With these set, a restart goes through the panel (the host really starts the bot again).
PANEL_URL=
PANEL_SERVER_ID=
PANEL_API_KEY=

# Media
VIDEO_ENABLED=on
VOICE_ENABLED=on
TTS_MAX_CHARS=500
YTDLP_CLIENTS=
YT_PROVIDER=

# Optional APIs (all free tiers)
FOOTBALL_DATA_API_KEY=your-football-data-org-key
GIPHY_API_KEY=your-giphy-beta-key
TELEGRAM_BOT_TOKEN=your-botfather-token
NASA_API_KEY=
OMDB_API_KEY=

# Feature gates (set to "off" to disable a feature)
# JARVIS_FEAT_UNO=off
# JARVIS_FEAT_WEREWOLF=off
# JARVIS_FEAT_AUTOBIO=off

# Save the scannable WhatsApp login QR to data/pairing-qr.png while unpaired (set off to disable)
PAIRING_QR=on
# qr = link by scanning pairing-qr.png only (no phone-number prompt, no pairing code). Leave empty for the pairing code.
PAIRING_METHOD=
# Linked-device identity shown on the phone: macos (default) | ubuntu | windows | custom "OS,Browser,Version"
WA_BROWSER=
# Force a WhatsApp Web version (e.g. 2.3000.1051488527). Empty = read the live version from web.whatsapp.com
WA_VERSION=
# Use another Baileys build (install it first, e.g. npm install @innovatorssoft/baileys). Empty = @whiskeysockets/baileys
BAILEYS_PKG=
# After WhatsApp answers a code request with 429 rate-overlimit the bot stops asking and stays idle (no restart loop).
# It remembers this in data/pairing-ratelimit.json for this many hours (default 4). PAIRING_RATELIMIT_IGNORE=on skips the wait.
PAIRING_RATELIMIT_HOURS=
PAIRING_RATELIMIT_IGNORE=
# The bot patches known pairing bugs into the installed Baileys at startup (see scripts/patch-baileys.js). off = don't
TAB_BAILEYS_PATCH=
